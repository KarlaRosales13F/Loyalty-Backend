        "body": {
          "mode": "raw",
          "raw": "{\n  \"current_password\": \"Password123!\",\n  \"new_password\": \"NewPassword123!\",\n  \"new_password2\": \"NewPassword123!\"\n}"
        },
        "url": {
          "raw": "{{loyalty}}/users/change-password/",
