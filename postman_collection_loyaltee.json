          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"telefono\": \"0987654321\"\n}"
        },
        "url": {
          "raw": "{{loyalty}}/users/update-profile/",
          "host": ["{{loyalty}}"],
          "path": ["users", "update-profile", ""]
