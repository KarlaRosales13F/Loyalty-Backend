    {
      "name": "Auth / Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "\r",
              "if (pm.response.code === 200) {\r",
              "    const responseData = pm.response.json();\r",
              "    \r",
              "    if (responseData.access) {\r",
              "        pm.environment.set(\"loyalty\", responseData.access);\r",
              "        console.log(\"¡Token guardado con éxito en {{loyalty}}!\");\r",
              "    } else {\r",
              "        console.warn(\"No se encontró la propiedad 'access' en la respuesta.\");\r",
              "    }\r",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
